# Ricochet — variables d'environnement (Phases 4+).
# Copier en `.env.local` (client Vite) et `.env` (serveur + PocketBase). Ne
# jamais commiter les vraies valeurs.

# --- client (préfixe VITE_, exposé au navigateur) ---
VITE_POCKETBASE_URL=
# URL du serveur de match ; par défaut ws://<host>:8787
VITE_MATCH_SERVER=

# --- serveur de match (Node, jamais exposé) ---
PORT=8787
POCKETBASE_URL=
# secret partagé avec pocketbase/pb_hooks/{settle-match,rollover-season}.pb.js —
# le serveur de match l'envoie en header X-Settle-Secret, PocketBase le lit
# via $os.getenv (même valeur des deux côtés). Voir pocketbase/README.md.
MATCH_SETTLE_SECRET=

# le superuser PocketBase (équivalent de la service-role key Supabase) se crée
# en CLI, pas via une variable d'env : `pocketbase superuser create ...`.
