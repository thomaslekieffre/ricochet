# Ricochet — variables d'environnement (Phases 4+).
# Copier en `.env.local` (client Vite) et `.env` (serveur). Ne jamais commiter les vraies valeurs.

# --- client (préfixe VITE_, exposé au navigateur) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# URL du serveur de match ; par défaut ws://<host>:8787
VITE_MATCH_SERVER=

# --- serveur de match (Node, jamais exposé) ---
PORT=8787
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# URL de la fonction settle-match
SETTLE_MATCH_URL=
